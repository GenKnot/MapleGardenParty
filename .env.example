# Supabase (server only). Leave empty in local dev to use the .data/db.json file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ char string used to sign session and staff cookies.
SESSION_SECRET=

# Shared passcode for volunteers at /staff (6+ chars).
STAFF_PASSCODE=

# Web3Forms public access key for the optional contact form.
NEXT_PUBLIC_WEB3FORMS_KEY=
